{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open 100-Day Plan Dashboard (Static)",
            "type": "shell",
            "command": "start",
            "args": ["index.html"],
            "presentation": {
                "reveal": "silent"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Streamlit: Launch Dashboard",
            "type": "shell",
            "command": ".venv\\Scripts\\python.exe",
            "args": ["-m", "streamlit", "run", "streamlit_app.py"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
